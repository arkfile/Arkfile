# Copy to lab.env and chmod 600. Do not commit lab.env.

# Watch-only Bitcoin extended public key. Never an extended private key.
BTC_XPUB=
BITCART_ADMIN_PASSWORD=

# This lab pays and watches mainnet.
BTC_NETWORK=mainnet
# External Bitcoin Electrum server (host:port:s for TLS).
# Electrum /data/config is always seeded with {"auto_connect": false} so wallet
# subscriptions never silently fail over to random public Electrum peers.
BTC_SERVER=bitcoin-mainnet.blockstream.info:50002:s
# Keep BTC_ONESERVER=false when using a public Electrum server so Electrum can
# still cross-check SPV block headers across peers. Set BTC_ONESERVER=true when
# BTC_SERVER is your own Electrum server.
BTC_ONESERVER=false

# Set to btc,xmr and start with: bash scripts/testing/bitcart-lab/paylab.sh up
BITCART_CRYPTOS=btc,xmr
XMR_NETWORK=mainnet
XMR_SERVER=https://xmr-node.cakewallet.com:18081
XMR_ADDRESS=
XMR_PRIVATE_VIEW_KEY=
XMR_RESTORE_HEIGHT=

# Bitcart internal log retention policy in days.
BITCART_LOG_RETENTION_DAYS=21

# Optional faster billing experiments
# ARKFILE_FREE_STORAGE_BYTES=10485760
# ARKFILE_BILLING_TICK_INTERVAL=1m
# ARKFILE_CUSTOMER_PRICE_USD_PER_TB_PER_MONTH=10.00
# ARKFILE_MIN_TOP_UP_USD=0.50
# BITCART_TX_SPEED=1
# XMR_TX_SPEED=5
